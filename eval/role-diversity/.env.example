# ACP runner checkout and optional runner-specific environment file.
ACP_DRIVER_RUNNER_DIR=../acp-client-prototype
ACP_DRIVER_ENV_FILE=../acp-client-prototype/.env

# Durable experiment-only B storage.
NEWIDE_B_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/newide_b

# Configure one provider family in the shell used to launch the experiment.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# OpenAI-compatible alternative.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Local ignored role/Skill config and output root.
ROLE_DIVERSITY_CONFIG=.newide/experiments/role-diversity/experiment.json
ROLE_DIVERSITY_RESULT_ROOT=.newide/experiments/role-diversity/results/manual
ROLE_DIVERSITY_RUN_TIMEOUT_MS=2700000
