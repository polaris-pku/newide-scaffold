# ============================================
# LLM Provider Configuration (example)
# Copy to .env and fill in your keys.
# ============================================

# Select provider: "deepseek" | "openai" | "anthropic" | "mock"
LLM_PROVIDER=deepseek

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (future)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (future)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================
# F-Eval / SWE-EVO harness (optional)
# ============================================
# Windows: use WSL Python for Docker harness (SWE-bench needs Linux).
# NEWIDE_SWE_EVO_PYTHON=wsl
# NEWIDE_SWE_EVO_WSL_DISTRO=Ubuntu-22.04
# NEWIDE_SWE_EVO_WSL_PYTHON=python3
# Or point at a specific interpreter:
# NEWIDE_SWE_EVO_PYTHON=C:\Users\lenovo\anaconda3\envs\py310\python.exe
# NEWIDE_SWE_EVO_ROOT=D:\SWE-EVO
