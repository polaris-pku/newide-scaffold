# ============================================
# LLM Provider Configuration (example)
# Copy to .env.local and fill in your keys.
# ============================================

# Select provider: "deepseek" | "openai" | "anthropic"
LLM_PROVIDER=deepseek

# ACP coding agent selected by the production backend.
ACP_AGENT_ID=claude

# Production B memory storage. The local acceptance helper uses these defaults.
NEWIDE_B_DATABASE_URL=postgresql://newide:newide_local@127.0.0.1:55432/newide_b

# Local CLI runs use the deterministic 32-dimension provider. Configure LiteLLM
# and a semantic embedding API when retrieval quality is part of the evaluation.
NEWIDE_B_EMBEDDING_PROVIDER=hash
NEWIDE_B_EMBEDDING_DIMENSIONS=32
# NEWIDE_LITELLM_CONFIG_DIR=/absolute/path/to/litellm/config

# Council execution strategy. plan_first makes roles propose/review a Plan,
# then returns the selected final Plan to the original primary Agent to implement.
# NEWIDE_COUNCIL_STRATEGY=classic
# Supported: classic | adaptive_lead | plan_first

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible credentials are required by the default embedding route.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (future)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Production completion Gate. The executable is launched directly (no shell)
# in the task workspace. Without this configuration, delivery is explicitly
# marked best_effort rather than verified.
# NEWIDE_GATE_COMMAND=pnpm
# NEWIDE_GATE_ARGS_JSON=["test"]
# NEWIDE_GATE_TIMEOUT_MS=120000
# Set to 1 only when the command actually verifies every completion criterion.
# NEWIDE_GATE_ATTESTS_COMPLETION_CRITERIA=0

# ============================================
# F-Eval / SWE-EVO harness (optional)
# ============================================
# Windows: use WSL Python for Docker harness (SWE-bench needs Linux).
# NEWIDE_SWE_EVO_PYTHON=wsl
# NEWIDE_SWE_EVO_WSL_DISTRO=Ubuntu-22.04
# NEWIDE_SWE_EVO_WSL_PYTHON=python3
# Or point at a specific interpreter:
# NEWIDE_SWE_EVO_PYTHON=C:\Users\lenovo\anaconda3\envs\py310\python.exe
# NEWIDE_SWE_EVO_ROOT=D:\SWE-EVO
