# ============================================
# LLM Provider Configuration (example)
# Copy to .env.local and fill in your keys.
# ============================================

# Select provider: "deepseek" | "openai" | "anthropic"
LLM_PROVIDER=deepseek

# ACP coding agent selected by the production backend.
#
# This selects the agent for the single legacy `acp-external` driver. To run
# different B-side roles through different coding agents, use driver profiles:
# copy `.agent/drivers.example.yaml` to `.agent/drivers.yaml` and map roles
# there. When a profile file exists, each profile's own `agent`/`ACP_AGENT_ID`
# wins for the roles it serves; this variable still drives `acp-external`.
ACP_AGENT_ID=claude

# Production B memory storage.
# - Default (omit NEWIDE_B_DATABASE_URL): embedded PGlite (WASM PostgreSQL +
#   pgvector) — zero install, no Docker, data persisted under <appStateRoot>/b/pglite.
#   NEWIDE_B_PGLITE_DATA_DIR=/absolute/path/to/pglite-data   # override data dir; ':memory:' = in-memory
# - Set NEWIDE_B_DATABASE_URL to use an external PostgreSQL (+pgvector) server
#   (self-hosted, cloud-managed like Neon/Supabase/RDS, or the Docker dev helper):
# NEWIDE_B_DATABASE_URL=postgresql://newide:newide_local@127.0.0.1:55432/newide_b

# Local CLI runs use the deterministic 32-dimension provider. Configure LiteLLM
# and a semantic embedding API when retrieval quality is part of the evaluation.
# B embedding. Use hash for local coordination without an embedding API.
# For Aliyun Model Studio (百炼) semantic retrieval:
#   NEWIDE_B_EMBEDDING_PROVIDER=litellm
#   NEWIDE_B_EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_API_KEY=                    # 百炼 API Key，只给 embedding 用
# Model name lives in src/litellm/config/embedding.yaml (qwen3.7-text-embedding).
NEWIDE_B_EMBEDDING_PROVIDER=hash
NEWIDE_B_EMBEDDING_DIMENSIONS=32
# NEWIDE_LITELLM_CONFIG_DIR=/absolute/path/to/litellm/config

# Non-interactive evaluation can approve newly promoted Skills immediately.
# Omit or set to 0 to keep explicit memory.approveSkill review.
#
# This switch means two different things on the two promotion paths, and both
# are intended: on the manual `memory.promoteSkills` RPC it approves the pending
# Skills that call just wrote; on the periodic Skill Promotion channel it makes
# a `pending_review` verdict from an earlier round get re-evaluated into an
# actual promotion. With it off, the channel only records verdicts.
# NEWIDE_B_SKILL_AUTO_APPROVE=1

# Persona evolution approval. Omit or set to 0 (default) to keep the channel in
# manual_review: a qualified role gets an evolution marker recording the verdict,
# and no Persona version is written. Set to 1 to let the next round turn those
# pending_review verdicts into real Persona versions (v+1).
#
# Note that Persona evolution only reads input that is already approved, so
# turning this on while skill promotion stays in manual_review will mostly
# report `no_approved_input`. The two switches are usually flipped together.
# NEWIDE_B_PERSONA_AUTO_APPROVE=1

# Promotion confidence gate (0..1, default 0.95). Keep the default: the
# usage-feedback write-back grows Experience confidence across tasks from the
# driver-reported effectiveness of referenced experiences, so genuinely reused
# effective Experiences naturally cross 0.95 in automated evaluation. Lowering
# this promotes almost everything and defeats selectivity.
#
# It gates both the experimental in-process path (BMemoryMaintenanceRunner) and
# the production Skill Promotion channel; they read it from the same place so a
# single Experience cannot get two different verdicts. Note the comparison is
# strictly greater: an Experience sitting exactly at 0.95 does not qualify, and
# the confidence cap is 0.98 (tiers: fully_effective +0.1, partially_effective
# +0.05, ineffective -0.1, not_applicable 0).
# NEWIDE_B_PROMOTION_CONFIDENCE_THRESHOLD=0.95

# How often the backend runs the memory-maintenance offline half: the two
# outbox channels (Context Delivery = Buffer -> Experience + archive, Driver
# Feedback = feedback -> confidence write-back, Pending Feedback Reconcile) and
# then the two jobs that scan derived candidates (Skill Promotion, Persona
# Evolution). It runs in-process on a timer; each round is bounded by item count
# and wall clock.
#
# Order within a round is the execution order and is load-bearing: a Driver
# feedback applied in this round is what lets a freshly extracted Experience
# cross the promotion threshold in the same round, and a Skill promoted in this
# round is what the Persona evolution input snapshot sees.
#
# Default: same value as NEWIDE_MAINTENANCE_INTERVAL_MS (1 hour when unset).
# Must be a positive integer — 0 is rejected at startup rather than silently
# disabling the drain. Set it low (e.g. 10000) when you want a task's
# Experience to land while you watch; `newide memory drain` is the manual
# catch-up entry point for everything else (add --dry-run to screen the two job
# channels without writing anything).
# NEWIDE_B_DELIVERY_DRAIN_INTERVAL_MS=3600000

# Council execution strategy. plan_first makes roles propose/review a Plan,
# then returns the selected final Plan to the original primary Agent to implement.
# NEWIDE_COUNCIL_STRATEGY=classic
# Supported: classic | adaptive_lead | plan_first

# Fixed Council seat mapping: <proposer0>,<proposer1>,<reviewer>,<synthesizer>.
# proposer0 = primary (implements the final Plan under plan_first), proposer1 = deputy.
# When set, each seat binds to exactly that role_id (no reuse); when unset, falls
# back to board-order assignment.
# NEWIDE_COUNCIL_SEATS=role_fullstack_engineer,role_ts_engineer,role_code_reviewer,role_synthesis_engineer

# Opt-in dynamic Council membership. The initial select_agent winner remains
# proposer 0; each remaining proposer/reviewer/synthesizer seat runs its own
# Market auction. Fixed NEWIDE_COUNCIL_SEATS takes precedence when configured.
# NEWIDE_COUNCIL_AUCTION_ENABLED=1
# NEWIDE_COUNCIL_PROPOSERS=2

# Disable the Agent Market auction (0/false) so select_agent always picks the
# configured primary (NEWIDE_PRIMARY_AGENT_ID) instead of running the auction.
# NEWIDE_AUCTION_ENABLED=1
# NEWIDE_PRIMARY_AGENT_ID=role_fullstack_engineer

# Default run mode when run.create omits `mode`. council enables the fixed
# proposer/review/synthesis workflow.
# NEWIDE_DEFAULT_RUN_MODE=single_agent

# Council role liveness follows Driver stream activity. The watchdog starts
# with the Driver turn, refreshes on every stream event, and steers a silent
# role through its existing Session and workspace.
# NEWIDE_COUNCIL_ROLE_INACTIVITY_TIMEOUT_MS=120000
# ACP child-process fallback watchdog, refreshed by stdout/stderr activity.
# ACP_DRIVER_INACTIVITY_TIMEOUT_MS=300000

# ADP driver-invocation retry policy (issue #149). Decides whether a DEFINITE
# `failed` driver invocation may be re-run automatically, keyed by the invoke's
# side_effect level (read_only | workspace_write | external). Defaults are all
# false (conservative). `unknown` outcomes (disconnect/timeout with unclear side
# effects) are NEVER auto-retried regardless of these settings, and this config
# never enters protocol frames. `error.retryable` is a hint only and drives
# nothing.
# NEWIDE_ADP_AUTO_RETRY_READ_ONLY=false
# NEWIDE_ADP_AUTO_RETRY_WORKSPACE_WRITE=false
# NEWIDE_ADP_AUTO_RETRY_EXTERNAL=false

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible credentials are required by the default embedding route.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (future)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Production completion Gate. The executable is launched directly (no shell)
# in the task workspace. Without this configuration, delivery is explicitly
# marked best_effort rather than verified.
# NEWIDE_GATE_COMMAND=pnpm
# NEWIDE_GATE_ARGS_JSON=["test"]
# NEWIDE_GATE_TIMEOUT_MS=120000
# Set to 1 only when the command actually verifies every completion criterion.
# NEWIDE_GATE_ATTESTS_COMPLETION_CRITERIA=0

# ============================================
# F-Eval / SWE-EVO harness (optional)
# ============================================
# Windows: use WSL Python for Docker harness (SWE-bench needs Linux).
# NEWIDE_SWE_EVO_PYTHON=wsl
# NEWIDE_SWE_EVO_WSL_DISTRO=Ubuntu-22.04
# NEWIDE_SWE_EVO_WSL_PYTHON=python3
# Or point at a specific interpreter / sibling checkout (relative to scaffold cwd):
# NEWIDE_SWE_EVO_PYTHON=python
# NEWIDE_SWE_EVO_ROOT=../SWE-EVO
# When NEWIDE_SWE_EVO_PYTHON=wsl, optional venv path relative to SWE-EVO root:
# NEWIDE_SWE_EVO_WSL_PYTHON=SWE-bench/.venv-swebench/bin/python

# Evaluation artifacts and repository mirrors default to repo-local ignored
# directories on every OS. Override them when a coworker uses another disk.
# NEWIDE_SWEEVO_ABLATION_ROOT=/absolute/path/to/sweevo-results
# NEWIDE_ABLATION_ROOT=/absolute/path/to/memory-ablation-results
# NEWIDE_SWE_MIRRORS_ROOT=/absolute/path/to/repository-mirrors

# Each memory-ablation arm gets its own PGlite data directory at
# <experiment-root>/<arm>/pglite, so arms never share memory state and no
# external PostgreSQL is needed. Re-running an arm that already holds memory
# fails unless NEWIDE_ABLATION_ALLOW_EXISTING_MEMORY=1 is set.

# ============================================
# Run observability files (optional)
# ============================================
# Both default to on; set 0/false to restore the pre-instrumentation behaviour
# (no file created, nothing written). They exist for A/B runs where the
# instrumentation itself is suspected of disturbing what is measured.
#   NEWIDE_TELEMETRY_JSONL      <state-root>/runs/<run_id>/telemetry.jsonl
#   NEWIDE_DRIVER_USAGE_JSONL   <state-root>/runs/<run_id>/driver-usage.jsonl
# driver-usage.jsonl carries one line per driver usage observation: context
# tokens used, plus the cost that arrives once at session end. Unlike the
# size-capped driver-stream.jsonl copy it is never truncated, so it is the
# source cost reports read from.
# NEWIDE_DRIVER_USAGE_JSONL=1

